<group name="custom_edr,">
 
  <!-- Parent rule: Matches the JSON format created by the Python script -->
<rule id="100050" level="0">
<decoded_as>json</decoded_as>
<field name="artifact_type">\.+</field>
<description>Custom EDR base event</description>
</rule>
 
  <rule id="100051" level="10">
<if_sid>100050</if_sid>
<description>Custom EDR: $(json.artifact_type) DoS flood detected from $(srcip)</description>
<mitre>
<id>T1498</id>
</mitre>
</rule>
 
</group>
